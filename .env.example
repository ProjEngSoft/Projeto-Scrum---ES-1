# Conexão com o banco de dados PostgreSQL (usada pelo Prisma)
DATABASE_URL="postgresql://conserta:conserta123@localhost:5432/conserta_aqui?schema=public"

# Credenciais usadas pelo docker-compose.yml
POSTGRES_USER="conserta"
POSTGRES_PASSWORD="conserta123"
POSTGRES_DB="conserta_aqui"
POSTGRES_PORT="5432"

# Sessão e armazenamento local de uploads
SESSION_COOKIE_NAME="conserta_session"
SESSION_TTL_DAYS="7"
UPLOAD_DIR="./storage/uploads"

# Usuário administrador inicial criado pelo seed (altere em produção)
SEED_ADMIN_EMAIL="admin@consertaaqui.local"
SEED_ADMIN_PASSWORD="Admin@123456"
